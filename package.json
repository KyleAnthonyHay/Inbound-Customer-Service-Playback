{
  "name": "playback-support-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync:assistant": "tsx --env-file=.env.local scripts/sync-assistant.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/test-tools.ts scripts/test-callbacks.ts scripts/test-manual.ts scripts/test-accounts.ts scripts/test-planning-center.ts scripts/test-text.ts scripts/test-seed-accounts.ts scripts/test-handoff.ts scripts/test-call-admission.ts scripts/test-call-closing.ts scripts/test-acknowledgments.ts scripts/test-call-history.ts scripts/test-call-metrics.ts scripts/test-evaluation-runs.ts",
    "test:acknowledgments": "tsx scripts/check-acknowledgments.ts",
    "planning-center:check": "tsx --env-file=.env.local scripts/check-planning-center.ts",
    "voice:test": "tsx --env-file=.env.local scripts/voice-test.ts",
    "text:test": "tsx --env-file=.env.local scripts/text-test.ts",
    "text:cases": "tsx --env-file=.env.local scripts/text-cases.ts",
    "sync:assistant:prod": "tsx --env-file=.env.production.local scripts/sync-assistant.ts",
    "voice:test:prod": "tsx --env-file=.env.production.local scripts/voice-test.ts",
    "release": "npm run typecheck && npm test && npx convex deploy -y && npx convex run seed:upsertAccounts --prod && npm run sync:assistant:prod && npx vercel --prod --yes",
    "manual:fetch": "tsx scripts/manual/fetch-manual.ts",
    "manual:build": "tsx scripts/manual/build-snapshot.ts",
    "manual:index": "tsx --env-file=.env.local scripts/manual/index-manual.ts",
    "manual:eval": "tsx --env-file=.env.local scripts/manual/eval-retrieval.ts"
  },
  "dependencies": {
    "@vapi-ai/web": "^3.1.0",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "lucide-react": "^1.65.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "node-html-parser": "^9.0.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "ws": "^8.22.0"
  }
}
